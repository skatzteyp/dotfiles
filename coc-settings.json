{
  // === ESLint ===
  "eslint.enable": true,
  "eslint.run": "onSave",
  "eslint.autoFixOnSave": false, // avoid conflicts with Prettier
  "eslint.filetypes": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact"
  ],
  "eslint.options": {
    "extensions": [".js", ".jsx", ".ts", ".tsx"]
  },

  // === Code Actions on Save ===
  // Let ESLint fix on save, but avoid double-formatting
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": true
  },

  // === Prettier ===
  // Prettier formats; ESLint fixes rules — no double conflict
  "prettier.enable": true,
  "prettier.requireConfig": false,
  "prettier.disableLanguages": ["vue"],

  // === TypeScript ===
  "tsserver.enable": true,
  "typescript.preferences.importModuleSpecifier": "non-relative",
  "tsserver.tsdk": ".yarn/sdks/typescript/lib",
  "eslint.nodePath": ".yarn/sdks",

  // === Tailwind CSS ===
  "tailwindCSS.includeLanguages": {
    "javascript": "javascriptreact",
    "javascriptreact": "javascriptreact",
    "typescript": "typescriptreact",
    "typescriptreact": "typescriptreact"
  },

  // ⚠️ Remove experimental regex unless needed — it causes breakage
  // "tailwindCSS.experimental.classRegex": [
  //   "tw`([^`]*)`",
  //   "classnames\\(([^)]*)\\)",
  //   "clsx\\(([^)]*)\\)"
  // ],

  // === CSS ===
  "css.validate": true,
  "css.lint.unknownAtRules": "ignore",

  // === Emmet ===
  "emmet.includeLanguages": {
    "javascript": "javascriptreact",
    "typescript": "typescriptreact",
    "javascriptreact": "html",
    "typescriptreact": "html"
  },

  // === Auto-formatting ===
  // Prettier formats the file, ESLint fixes rules — stable combo
  "coc.preferences.formatOnSaveFiletypes": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact",
    "json",
    "css",
    "scss",
    "html"
  ],

  // === Suggestions ===
  "suggest.noselect": false,
  "suggest.enablePreselect": true,

  // === Jump behavior ===
  "coc.preferences.jumpCommand": "tab drop",

  // === Prisma ===
  "prisma.enable": true,
  "prisma.enableSyntaxHighlighting": true,
  "prisma.schemaFile": "schema.prisma"
}
