{
  // === ESLint ===
  "eslint.enable": true,
  "eslint.run": "onSave", // just lint on save
  "eslint.autoFixOnSave": false, // DO NOT auto-fix on save
  "eslint.filetypes": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact"
  ],
  "eslint.options": {
    "extensions": [".js", ".jsx", ".ts", ".tsx"]
  },

  // ❌ IMPORTANT: Disable fixAll on save
  // This is what was causing ESLint to also mutate the buffer
  "editor.codeActionsOnSave": {},

  // === Prettier (single source of formatting truth) ===
  "prettier.enable": true,
  "prettier.requireConfig": true,
  "prettier.disableLanguages": ["vue"],

  // === TypeScript / TS Server ===
  "tsserver.enable": true,
  "typescript.preferences.importModuleSpecifier": "non-relative",

  // === Tailwind CSS ===
  "tailwindCSS.includeLanguages": {
    "javascript": "javascriptreact",
    "javascriptreact": "javascriptreact",
    "typescript": "typescriptreact",
    "typescriptreact": "typescriptreact"
  },

  // ⚠ Leave this off for now; it only affects IntelliSense, not needed
  // "tailwindCSS.experimental.classRegex": [
  //   "tw`([^`]*)`",
  //   "classnames\\(([^)]*)\\)",
  //   "clsx\\(([^)]*)\\)"
  // ],

  // === CSS ===
  "css.validate": true,
  "css.lint.unknownAtRules": "ignore",

  // === Emmet ===
  "emmet.includeLanguages": {
    "javascript": "javascriptreact",
    "typescript": "typescriptreact",
    "javascriptreact": "html",
    "typescriptreact": "html"
  },

  // === Format on save (Prettier only) ===
  "coc.preferences.formatOnSaveFiletypes": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact",
    "json",
    "css",
    "scss",
    "html"
  ],

  // === Completion behavior ===
  "suggest.noselect": false,
  "suggest.enablePreselect": true,

  // === Jumps ===
  "coc.preferences.jumpCommand": "tab drop",

  // === Prisma (coc-prisma) ===
  "prisma.enable": true,
  "prisma.enableSyntaxHighlighting": true,
  "prisma.schemaFile": "schema.prisma"
}
